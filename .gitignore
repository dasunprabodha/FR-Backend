# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
.env
# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/

# Local runtime storage - captured registration images, card-crop and comparison-analysis
# diagnostics, and evaluation-run outputs. Never meant to be committed.
data/

# Local credential overrides. application.yml imports this file when present
# (spring.config.import), so real AWS keys live here and never enter source control.
# application-local.yml.example is the committed template.
application-local.yml
!application-local.yml.example
